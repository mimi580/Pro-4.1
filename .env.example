# ============================================================
# DERIV EXPIRYRANGE BOT — Railway Environment Variables
# Copy these into Railway → Variables tab
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
DERIV_API_TOKEN=your_deriv_api_token_here
DERIV_APP_ID=1089

# ── CONTRACT ─────────────────────────────────────────────────
SYMBOL=1HZ10V
DURATION=2
BARRIER=1.7

# ── RISK / MARTINGALE ─────────────────────────────────────────
INITIAL_STAKE=0.35
MARTINGALE_MUL=1.5
MAX_LOSSES=5
TARGET_PROFIT=5.0
STOP_LOSS=15.0

# ── SIGNAL GATES ─────────────────────────────────────────────
MIN_VOTES=3
MIN_TICKS=120

# ATR regime thresholds
REGIME_LOW=0.80
REGIME_HIGH=1.20

# Bollinger Band width (as fraction of price)
BB_NARROW=0.020
BB_WIDE=0.040

# RSI neutral zone
RSI_MID_LOW=35.0
RSI_MID_HIGH=65.0

# EMA distance (multiples of ATR)
EMA_DIST_IN=1.2

# Candle body ratio threshold
BODY_IN=0.50

# Tick streak threshold
STREAK_IN=4

# ── RESILIENCE ───────────────────────────────────────────────
LOCK_TIMEOUT=130
BUY_RETRIES=8
RECONNECT_MIN=2
RECONNECT_MAX=60
WS_PING=30
ORPHAN_ATTEMPTS=4
ORPHAN_INTERVAL=3
